# SUPERFINANCE — copy to .env (never commit secrets)

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# SQLite for local zero-setup. Switch to Postgres in production:
# DATABASE_URL=postgresql+psycopg://superfinance:superfinance@localhost:5432/superfinance
DATABASE_URL=sqlite:///./superfinance.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN=http://localhost:5173

# Development OTP is 424242. Production must set a real SMS provider.
DEV_OTP=424242
OTP_EXPIRY_MINUTES=10

STORAGE_DIR=./storage
MAX_UPLOAD_MB=20
