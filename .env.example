# SUPERFINANCE — copy to .env (never commit .env)
# cp .env.example .env   (or: copy .env.example .env on Windows)

# development | production
ENVIRONMENT=development

# REQUIRED in production: long random string (not the placeholder below)
SECRET_KEY=change-me-to-a-long-random-string

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Local demo (SQLite). Production: use Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/superfinance
DATABASE_URL=sqlite:///./superfinance.db

# Comma-separated browser origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN=http://localhost:5173

# Development OTP only. Production mobile OTP returns 501 until an SMS provider is wired.
DEV_OTP=424242
OTP_EXPIRY_MINUTES=10

STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# HTTPS production: must be true so auth cookies are marked Secure
COOKIE_SECURE=false

# Cookie SameSite: lax (same-site / reverse-proxy) | none (FE and API on different sites; requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
