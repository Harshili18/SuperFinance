# Optional. Leave empty for same-origin / Vite proxy (local) or Vercel rewrites to /api.
# For a split host (Vercel FE + API elsewhere) set the API origin only, no trailing slash:
# VITE_API_BASE_URL=https://api.example.com
#
# When using a different site for the API, the API must set:
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
#   CORS_ORIGINS=<your Vercel URL>
VITE_API_BASE_URL=
